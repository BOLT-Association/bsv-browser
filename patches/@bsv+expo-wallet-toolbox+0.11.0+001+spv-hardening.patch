@@ -0,0 +1,105 @@
+/**
+ * Narrows a `Services` instance to Arcade only, for spv chain mode.
+ *
+ * Runs AFTER the host has registered whatever providers it likes (WalletContext
+ * adds Taal, GorillaPool, WhatsOnChain and Bitails to the broadcast chain and
+ * swaps in a WhatsOnChain BUMP provider), so the result does not depend on the
+ * order those were added in.
+ *
+ *  · Proofs, tx status and broadcast keep only the Arcade providers.
+ *  · Raw-tx, UTXO and address-history lookups have no Arcade equivalent (Arcade
+ *    has no raw-tx, UTXO, address or outspend endpoint). They are replaced by a
+ *    provider that answers with an explicit ERROR. An empty collection would
+ *    throw an incidental TypeError, and an empty result would read as "nothing
+ *    there"; neither is acceptable for a lookup that was blocked on purpose.
+ *    Outputs and parent transactions arrive inside BEEFs instead.
+ */
+import type { Services } from '@bsv/wallet-toolbox-mobile'
+
+interface Entry {
+  name: string
+  service: (...args: any[]) => Promise<any>
+}
+interface Collection {
+  services: Entry[]
+  _index: number
+}
+
+const isArcade = (e: Entry): boolean => /^arcade/i.test(e.name)
+
+const NO_INDEXER = 'SpvNoIndexer'
+const message = (what: string): string =>
+  `spv mode: ${what} is not available. Arcade has no such endpoint; outputs and parent transactions arrive in BEEFs.`
+
+function keepArcadeOnly(c: Collection): void {
+  c.services = c.services.filter(isArcade)
+  c._index = 0
+}
+
+function replaceWithError(
+  c: Collection,
+  make: (err: Error, firstArg: unknown) => Record<string, unknown>,
+  what: string
+): void {
+  c.services = [
+    {
+      name: NO_INDEXER,
+      service: async (firstArg?: unknown) => make(new Error(message(what)), firstArg)
+    }
+  ]
+  c._index = 0
+}
+
+export interface SpvServiceOptions {
+  /** Replaces the Arcade `getMerklePath` provider (see arcadeMerklePath.ts) for chains the toolbox's own cannot read. */
+  merklePath?: (txid: string) => Promise<any>
+  /**
+   * The wallet's verified header chain. When given, `hashToHeader` (which the toolbox's Arcade
+   * proof path uses to canonicalise a proof's header) answers from it instead of asking the
+   * remote chaintracks and checking only proof-of-work against the mainnet limit.
+   */
+  headers?: { findHeaderForBlockHash(hash: string): Promise<any> }
+}
+
+export function applySpvServices(services: Services, options: SpvServiceOptions = {}): void {
+  const s = services as unknown as Record<string, Collection>
+
+  // The toolbox SSE client accepts an absent API key but rejects an empty one, and
+  // createServiceOptions produces '' when there is no key.
+  const arcadeConfig = (services as any).options?.arcadeConfig
+  if (arcadeConfig && !arcadeConfig.apiKey) arcadeConfig.apiKey = undefined
+
+  keepArcadeOnly(s.getMerklePathServices)
+  if (options.headers) {
+    const headers = options.headers
+    ;(services as any).hashToHeader = async (hash: string) => {
+      const header = await headers.findHeaderForBlockHash(String(hash).toLowerCase())
+      if (!header) throw new Error(`block ${hash} is not in the verified header chain`)
+      return header
+    }
+  }
+  if (options.merklePath) {
+    for (const e of s.getMerklePathServices.services) e.service = options.merklePath
+  }
+  keepArcadeOnly(s.getStatusForTxidsServices)
+  keepArcadeOnly(s.postBeefServices)
+  if (s.getMerklePathServices.services.length === 0 || s.postBeefServices.services.length === 0) {
+    throw new Error('spv mode needs an Arcade provider for proofs and broadcast, but none is configured (is the Arcade URL set?)')
+  }
+
+  replaceWithError(
+    s.getRawTxServices,
+    (error, txid) => ({ txid, name: NO_INDEXER, error }),
+    'raw transaction lookup'
+  )
+  replaceWithError(
+    s.getUtxoStatusServices,
+    error => ({ name: NO_INDEXER, status: 'error', error, details: [] }),
+    'UTXO status lookup'
+  )
+  replaceWithError(
+    s.getScriptHashHistoryServices,
+    error => ({ name: NO_INDEXER, status: 'error', error, history: [] }),
+    'address history lookup'
+  )
+}
