@@ -0,0 +1,19 @@
+/**
+ * The remote the header sync reads from. The toolbox's own client rejects any
+ * header above the mainnet proof-of-work limit, so a chain with other rules
+ * (regtest) is read through the raw transport instead; the header store then
+ * applies that chain's rules itself.
+ */
+import { ChaintracksServiceClient, type ChaintracksClientApi } from '@bsv/wallet-toolbox-mobile'
+import type { SpvOptions } from '../toolboxConfig'
+import { RawChaintracksClient } from './rawChaintracksClient'
+
+export function makeRemoteChaintracks(
+  walletChain: 'main' | 'test' | 'ttn',
+  url: string,
+  spv: SpvOptions,
+  apiKey?: string | null
+): ChaintracksClientApi {
+  if (spv.rules === 'regtest') return new RawChaintracksClient(url, undefined, apiKey) as unknown as ChaintracksClientApi
+  return new ChaintracksServiceClient(walletChain, url)
+}
diff --git a/node_modules/@bsv/expo-wallet-toolbox/core/spv/serviceOrigin.ts b/node_modules/@bsv/expo-wallet-toolbox/core/spv/serviceOrigin.ts
new file mode 100644
index 0000000..27903ee
--- /dev/null
+++ b/node_modules/@bsv/expo-wallet-toolbox/core/spv/serviceOrigin.ts
@@ -0,0 +1,22 @@
+/**
+ * Which origins spv mode will send chain traffic (and an Arcade API key) to:
+ * https anywhere, plain http only to a local-development host, and never a URL
+ * that carries credentials. The same rule `toolboxConfig` applies to the backup
+ * and Mandala origins (`isAllowedServiceOrigin`); kept here as its own copy
+ * because `toolboxConfig` imports this package's spv code. A test pins the two
+ * together.
+ */
+const PRIVATE_HOST =
+  /^(localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})$/
+
+export function isAllowedSpvOrigin(url: string): boolean {
+  let parsed: URL
+  try {
+    parsed = new URL(url)
+  } catch {
+    return false
+  }
+  if (parsed.username || parsed.password) return false
+  if (parsed.protocol === 'https:') return true
+  return parsed.protocol === 'http:' && PRIVATE_HOST.test(parsed.hostname)
+}
diff --git a/node_modules/@bsv/expo-wallet-toolbox/core/spv/spvEventSource.ts b/node_modules/@bsv/expo-wallet-toolbox/core/spv/spvEventSource.ts
new file mode 100644
index 0000000..9167386
--- /dev/null
+++ b/node_modules/@bsv/expo-wallet-toolbox/core/spv/spvEventSource.ts
@@ -0,0 +1,31 @@
+/**
+ * Arcade serves its status stream (SSE) from a separate listener from its API
+ * (spv-testnet: API :8080, SSE :8082), but the toolbox's `ArcSSEClient` builds
+ * `${arcadeUrl}/events?callbackToken=…`. This wraps the app's EventSource class so
+ * that URL, and only that URL, is moved to the SSE listener; the headers (including
+ * the API key and Last-Event-ID) pass through unchanged.
+ *
+ * With no SSE URL there is no class, so the toolbox's task reports "SSE disabled"
+ * and proofs arrive by polling alone. A URL that is not the Arcade events URL is
+ * refused, so the callback token and API key cannot be sent anywhere else.
+ */
+type EventSourceCtor = new (url: any, options?: any) => any
+
+export function makeSpvEventSourceClass(
+  Base: EventSourceCtor,
+  arcUrl: string,
+  sseUrl: string | undefined
+): EventSourceCtor | undefined {
+  if (!sseUrl) return undefined
+  const from = `${arcUrl.replace(/\/+$/, '')}/events`
+  const to = `${sseUrl.replace(/\/+$/, '')}/events`
+  return class SpvEventSource extends Base {
+    constructor(url: any, options?: any) {
+      const u = String(url)
+      if (!(u === from || u.startsWith(`${from}?`))) {
+        throw new Error('spv mode: refusing to open an event stream to a URL that is not the Arcade events URL')
+      }
+      super(`${to}${u.slice(from.length)}`, options)
+    }
+  }
+}
diff --git a/node_modules/@bsv/expo-wallet-toolbox/core/spv/spvMode.ts b/node_modules/@bsv/expo-wallet-toolbox/core/spv/spvMode.ts
new file mode 100644
index 0000000..98093a2
--- /dev/null
+++ b/node_modules/@bsv/expo-wallet-toolbox/core/spv/spvMode.ts
@@ -0,0 +1,122 @@
+/**
+ * spv chain mode: the wallet gets chain data only from the configured Arcade
+ * (broadcast, status, proofs, SSE) and Arcade's chaintracks (headers), and
+ * checks headers and proofs itself. No public indexer is consulted.
+ *
+ * FAILS CLOSED. `parseChainMode` treats anything it does not recognise as
+ * `spv`, so a typo can never silently put the wallet back on public indexers.
+ *
+ * The mode is enforced in two places that cannot come apart:
+ *  · wiring (WalletContext registers only Arcade-backed services in spv), and
+ *  · a fetch guard (`installIndexerGuard`) that rejects any request to a known
+ *    public indexer host, so a call site the wiring missed (there are many
+ *    hard-coded ones) becomes a network error instead of a leak. An error is
+ *    deliberate: a blocked lookup must never read as "not found".
+ *
+ * The guard is a deny-list of indexer hosts, not an allow-list: the app also
+ * talks to MessageBox, price and identity services that are not chain state.
+ */
+import type { AppChain } from '../config'
+import { isAllowedSpvOrigin } from './serviceOrigin'
+
+export type ChainMode = 'public' | 'spv'
+
+export function parseChainMode(raw: string | null | undefined): ChainMode {
+  const v = (raw ?? '').trim().toLowerCase()
+  if (v === '' || v === 'public') return 'public'
+  return 'spv'
+}
+
+/** Registrable-domain suffixes of public chain indexers and public ARC endpoints. */
+const BLOCKED_SUFFIXES = [
+  'whatsonchain.com',
+  'woc-ttn.bsvblockchain.tech',
+  'taal.com',
+  'gorillapool.io',
+  'gorillapool.com',
+  'bitails.io',
+  'bitails.net'
+]
+
+/** True when `url` points at a public indexer. An unparseable URL counts as blocked. */
+export function isBlockedIndexerUrl(url: string): boolean {
+  let host: string
+  try {
+    host = new URL(url).hostname.toLowerCase()
+  } catch {
+    return true
+  }
+  return BLOCKED_SUFFIXES.some(s => host === s || host.endsWith('.' + s))
+}
+
+const GUARDED = Symbol.for('bsv-browser.spv.indexerGuard')
+
+function urlOf(input: unknown): string {
+  if (typeof input === 'string') return input
+  if (input instanceof URL) return input.href
+  const maybe = input as { url?: unknown; href?: unknown } | null
+  if (maybe && typeof maybe.url === 'string') return maybe.url
+  if (maybe && typeof maybe.href === 'string') return maybe.href
+  return String(input)
+}
+
+/**
+ * Wrap `target.fetch` so requests to public indexers reject. Returns a function
+ * that restores the original. Installing again on an already-guarded fetch is a
+ * no-op, so repeated configuration cannot stack wrappers.
+ */
+export function installIndexerGuard(target: { fetch: typeof fetch }): () => void {
+  const original = target.fetch
+  if ((original as unknown as Record<symbol, unknown>)[GUARDED]) return () => {}
+  const guarded = (async (input: unknown, init?: unknown) => {
+    const url = urlOf(input)
+    if (isBlockedIndexerUrl(url)) {
+      throw new Error(`spv mode: refusing to contact a public chain indexer (${safeHost(url)})`)
+    }
+    return original(input as never, init as never)
+  }) as unknown as typeof fetch
+  ;(guarded as unknown as Record<symbol, unknown>)[GUARDED] = true
+  target.fetch = guarded
+  return () => {
+    if (target.fetch === guarded) target.fetch = original
+  }
+}
+
+function safeHost(url: string): string {
+  try {
+    return new URL(url).hostname
+  } catch {
+    return 'unparseable url'
+  }
+}
+
+const ENV_PREFIX: Record<AppChain, string> = {
+  main: 'EXPO_PUBLIC_',
+  test: 'EXPO_PUBLIC_TEST_',
+  teratest: 'EXPO_PUBLIC_TERATEST_'
+}
+
+/** spv needs an explicit Arcade and chaintracks for the chain, neither of them a public indexer. */
+export function assertSpvEndpoints(
+  chain: AppChain,
+  svc: { arcUrl?: string | null; chaintracksUrl?: string | null; sseUrl?: string | null }
+): void {
+  const p = ENV_PREFIX[chain]
+  if (!svc.arcUrl) throw new Error(`spv mode needs an Arcade URL for ${chain}: set ${p}ARC_URL`)
+  if (!svc.chaintracksUrl) throw new Error(`spv mode needs a chaintracks URL for ${chain}: set ${p}CHAINTRACKS_URL`)
+  const urls: (readonly [string, string])[] = [
+    ['Arcade', svc.arcUrl],
+    ['chaintracks', svc.chaintracksUrl]
+  ]
+  if (svc.sseUrl) urls.push(['SSE', svc.sseUrl])
+  for (const [name, url] of urls) {
+    if (isBlockedIndexerUrl(url)) {
+      throw new Error(`spv mode: the ${name} URL for ${chain} is a public indexer, not an Arcade deployment`)
+    }
+    if (!isAllowedSpvOrigin(url)) {
+      throw new Error(
+        `spv mode: the ${name} URL for ${chain} must be https (plain http is allowed only for a local-development host) and carry no credentials`
+      )
+    }
+  }
+}
diff --git a/node_modules/@bsv/expo-wallet-toolbox/core/spv/zeroConf.ts b/node_modules/@bsv/expo-wallet-toolbox/core/spv/zeroConf.ts
new file mode 100644
index 0000000..c7707e6
--- /dev/null
+++ b/node_modules/@bsv/expo-wallet-toolbox/core/spv/zeroConf.ts
@@ -0,0 +1,96 @@
+/**
+ * Zero-conf for spv mode: accept a payment whose transaction is not mined yet, but
+ * only once Arcade has SEEN it on the network.
+ *
+ * The toolbox will internalize a BEEF whose subject has no merkle proof (its
+ * ancestors must be proven) and make the output spendable at once, with no check that
+ * the network ever saw the transaction. A sender could hand over a transaction it
+ * never broadcast, or that conflicts with one already on the network. This wrapper
+ * closes that: before `internalizeAction`, every transaction in the BEEF that has no
+ * BUMP of its own must be `SEEN_ON_NETWORK` (or better) on Arcade, with no
+ * conflict. Anything else is refused, and the wallet is not called, so nothing is
+ * stored. Unlike Hodos, which keeps such an output unspendable until it is mined, a
+ * payment that is not seen yet is refused rather than parked; the sender (or a retry)
+ * presents it again once it has been broadcast.
+ *
+ * A fully proven BEEF is passed straight through without a network call. Input that
+ * cannot be read as a BEEF is left to the wallet, which rejects it itself.
+ *
+ * The toolbox then broadcasts the unmined tx itself (its request is `unsent`), which
+ * is also what registers this wallet's callback token with Arcade for push events.
+ */
+import { Beef } from '@bsv/sdk'
+import { arcadeAuthHeaders } from './arcadeAuth'
+
+const SEEN = new Set(['SEEN_ON_NETWORK', 'SEEN_ON_MULTIPLE_NODES', 'SEEN_MULTIPLE_NODES', 'MINED', 'IMMUTABLE'])
+const CONFLICT = new Set(['REJECTED', 'DOUBLE_SPEND_ATTEMPTED', 'SEEN_IN_ORPHAN_MEMPOOL'])
+
+export interface ZeroConfOptions {
+  arcUrl: string
+  apiKey?: string | null
+  fetcher?: typeof fetch
+  /** How long to wait for Arcade to have seen a tx (it usually takes well under a second). Default 4 s. */
+  waitMs?: number
+  pollMs?: number
+}
+
+type Verdict = { ok: true } | { ok: false; reason: string }
+
+async function checkSeen(txid: string, o: Required<Pick<ZeroConfOptions, 'waitMs' | 'pollMs'>> & {
+  base: string
+  headers: Record<string, string>
+  fetcher: typeof fetch
+}): Promise<Verdict> {
+  const end = Date.now() + o.waitMs
+  let last = 'unknown to Arcade'
+  for (;;) {
+    try {
+      const res = await o.fetcher(`${o.base}/tx/${txid}`, { headers: o.headers })
+      if (res.ok) {
+        const body = (await res.json()) as { txStatus?: string }
+        const st = String(body.txStatus ?? '')
+        if (CONFLICT.has(st)) return { ok: false, reason: `Arcade reports ${st}` }
+        if (SEEN.has(st)) return { ok: true }
+        last = st === '' ? 'no status' : st
+      } else {
+        last = res.status === 404 ? 'unknown to Arcade' : `Arcade answered HTTP ${res.status}`
+      }
+    } catch {
+      last = 'Arcade could not be reached'
+    }
+    if (Date.now() >= end) return { ok: false, reason: `not seen on the network (last status: ${last})` }
+    await new Promise(r => setTimeout(r, o.pollMs))
+  }
+}
+
+export function guardZeroConfInternalize<A extends { tx: number[] }, R>(
+  inner: (args: A, originator?: string) => Promise<R>,
+  options: ZeroConfOptions
+): (args: A, originator?: string) => Promise<R> {
+  const base = options.arcUrl.replace(/\/+$/, '')
+  const headers = arcadeAuthHeaders(options.apiKey)
+  const fetcher = options.fetcher ?? ((...a: Parameters<typeof fetch>) => fetch(...a))
+  const waitMs = options.waitMs ?? 4000
+  const pollMs = options.pollMs ?? 250
+
+  return async (args, originator) => {
+    let unproven: string[] = []
+    try {
+      const beef = Beef.fromBinary(args.tx)
+      unproven = beef.txs.filter(t => !t.isTxidOnly && !t.hasProof).map(t => t.txid)
+    } catch {
+      return inner(args, originator)
+    }
+    if (unproven.length === 0) return inner(args, originator)
+
+    const verdicts = await Promise.all(unproven.map(txid => checkSeen(txid, { base, headers, fetcher, waitMs, pollMs })))
+    const bad = verdicts.findIndex(v => !v.ok)
+    if (bad >= 0) {
+      const v = verdicts[bad] as { ok: false; reason: string }
+      throw new Error(
+        `zero-conf: transaction ${unproven[bad]} is not mined and ${v.reason}; not accepting an unmined payment until Arcade has seen it`
+      )
+    }
+    return inner(args, originator)
+  }
+}
