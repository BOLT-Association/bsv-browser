@@ -0,0 +1,78 @@
+/**
+ * A `getMerklePath` service for spv mode: the BUMP Arcade reports for a mined
+ * transaction, paired with the header from the wallet's OWN verified chain.
+ *
+ * Why not the toolbox's built-in Arcade provider: it also validates the header's
+ * proof-of-work against the mainnet limit, so it refuses every proof on a chain
+ * with other rules (regtest). It also takes the header from wherever the services
+ * point; here the header is the verified one by construction.
+ *
+ * What this does NOT do is vouch for the proof. The toolbox authenticates it
+ * before storing (`EntityProvenTx.fromReq` -> `isValidRootForHeight` on the chain
+ * tracker), and in spv mode that tracker is the strict, verified-chain-only one.
+ * A proof whose height the verified chain does not hold yet comes back as an
+ * ERROR with no merklePath, so the request stays pending and is retried after the
+ * next header sync, and is never stored unverified.
+ */
+import { MerklePath } from '@bsv/sdk'
+import { arcadeAuthHeaders } from './arcadeAuth'
+
+type Header = { height: number; hash: string; merkleRoot: string } & Record<string, unknown>
+
+export interface MerklePathServiceResult {
+  name: string
+  merklePath?: MerklePath
+  header?: Header
+  error?: Error
+  notes?: { what: string; [k: string]: unknown }[]
+}
+
+export function createArcadeMerklePathService(
+  arcUrl: string,
+  getVerifiedHeader: (height: number) => Promise<Header | undefined>,
+  fetcher: typeof fetch = (...a) => fetch(...a),
+  apiKey?: string | null
+): (txid: string) => Promise<MerklePathServiceResult> {
+  const base = arcUrl.replace(/\/+$/, '')
+  const headers = arcadeAuthHeaders(apiKey)
+  return async txid => {
+    if (!/^[0-9a-fA-F]{64}$/.test(txid)) throw new Error('getMerklePath: txid must be 64 hex characters')
+    const name = 'Arcade'
+    const note = (what: string, extra: Record<string, unknown> = {}) => [{ what, when: new Date().toISOString(), ...extra }]
+    const res = await fetcher(`${base}/tx/${txid.toLowerCase()}`, { headers })
+    if (res.status === 404) return { name, notes: note('getMerklePathNoData') }
+    if (!res.ok) return { name, notes: note('getMerklePathBadStatus', { httpStatus: res.status }) }
+    const body = (await res.json()) as { merklePath?: unknown; blockHeight?: unknown }
+    if (typeof body.merklePath !== 'string' || body.merklePath === '') {
+      return { name, notes: note('getMerklePathNoData') }
+    }
+    try {
+      const merklePath = MerklePath.fromHex(body.merklePath)
+      if (body.blockHeight !== undefined && body.blockHeight !== merklePath.blockHeight) {
+        throw new Error('the BUMP height does not match the block height Arcade reported')
+      }
+      // Throws unless this exact txid is a leaf of the proof.
+      merklePath.computeRoot(txid.toLowerCase())
+      const header = await getVerifiedHeader(merklePath.blockHeight)
+      if (!header) throw new Error(`height ${merklePath.blockHeight} is not in the verified header chain`)
+      return { name, merklePath, header, notes: note('getMerklePathSuccess') }
+    } catch (e) {
+      const error = e instanceof Error ? e : new Error(String(e))
+      return { name, error, notes: note('getMerklePathError', { description: error.message }) }
+    }
+  }
+}
+
+/**
+ * The `getMerklePath` override for a chain with non-mainnet rules (regtest), or
+ * undefined when the toolbox's own Arcade provider can read the chain.
+ */
+export function arcadeMerklePathOverride(
+  spv: { rules?: 'default' | 'regtest' },
+  arcUrl: string,
+  tracker: { findHeaderForHeight(height: number): Promise<Header | undefined> },
+  apiKey?: string | null
+): { merklePath: (txid: string) => Promise<MerklePathServiceResult> } | undefined {
+  if (spv.rules !== 'regtest') return undefined
+  return { merklePath: createArcadeMerklePathService(arcUrl, h => tracker.findHeaderForHeight(h), undefined, apiKey) }
+}
