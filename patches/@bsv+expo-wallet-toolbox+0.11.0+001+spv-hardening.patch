@@ -0,0 +1,19 @@
+/**
+ * The Authorization header for an Arcade deployment that requires an API key.
+ * Same scheme the toolbox's own Arcade and SSE clients use (`Bearer <key>`).
+ *
+ * Every spv Arcade client takes the key at construction and sends it only to its
+ * own base URL, and `assertSpvEndpoints` has already required https (or a
+ * local-development host) for that URL. A key that could split or bloat a header
+ * is refused, and is never put in an error message.
+ */
+const MAX_KEY = 4096
+
+export function arcadeAuthHeaders(apiKey: string | null | undefined): Record<string, string> {
+  const key = (apiKey ?? '').trim()
+  if (key === '') return {}
+  if (key.length > MAX_KEY || /[\u0000-\u001f\u007f]/.test(key)) {
+    throw new Error('Arcade API key is not valid for an HTTP header')
+  }
+  return { Authorization: `Bearer ${key}` }
+}
