+/**
+ * Which trust anchor and which difficulty rules the header window uses for a
+ * chain. Defaults to the built-in checkpoint and the toolbox's rules; spv
+ * options can point the window at a different chain (a local regtest, say).
+ * Kept pure so it is testable without a wallet.
+ */
+import { regtestRules, type HeaderRules } from '../headers/chainRules'
+import { HEADER_CHECKPOINTS, type HeaderCheckpoint } from '../headers/checkpoints'
+import type { SpvOptions } from '../toolboxConfig'
+
+export interface HeaderSetup {
+  anchor: HeaderCheckpoint
+  /** undefined = the store's own default for the chain. */
+  rules: HeaderRules | undefined
+}
+
+export function resolveHeaderSetup(
+  walletChain: string,
+  spv: SpvOptions,
+  mode: 'public' | 'spv' = 'public'
+): HeaderSetup | undefined {
+  // spv trusts the wallet's own chain, so the chain's difficulty rules must be enforced. Only
+  // regtest has them today; main / test / ttn would accept any chain at the proof-of-work limit
+  // on top of the checkpoint. Refuse rather than run spv with a check that is not there.
+  if (mode === 'spv' && spv.rules !== 'regtest') {
+    throw new Error(
+      `spv mode: difficulty-adjustment rules are not implemented for ${walletChain}. ` +
+        'Only EXPO_PUBLIC_SPV_RULES=regtest is supported today.'
+    )
+  }
+  if (spv.rules === 'regtest' && !spv.anchor) {
+    throw new Error(
+      'spv regtest rules need an explicit anchor (the regtest genesis): a built-in checkpoint is not a regtest chain'
+    )
+  }
+  const anchor = spv.anchor ?? (HEADER_CHECKPOINTS as Record<string, HeaderCheckpoint | undefined>)[walletChain]
+  if (!anchor) return undefined
+  return { anchor, rules: spv.rules === 'regtest' ? regtestRules : undefined }
+}
diff --git a/node_modules/@bsv/expo-wallet-toolbox/core/spv/monitorHeaders.ts b/node_modules/@bsv/expo-wallet-toolbox/core/spv/monitorHeaders.ts
new file mode 100644
index 0000000..3bd7c58
--- /dev/null
+++ b/node_modules/@bsv/expo-wallet-toolbox/core/spv/monitorHeaders.ts
@@ -0,0 +1,71 @@
+/**
+ * The monitor's header checks, under the chain's own difficulty rules.
+ *
+ * The toolbox monitor copies every header it handles (the chain tip TaskNewHeader polls, the
+ * header it then hands to `processNewBlockHeader`, reorg tips) through a check that requires
+ * mainnet proof of work. A header of a chain with other rules (regtest) can never pass it, so
+ * TaskNewHeader fails on every poll, `lastNewHeader` is never set and TaskCheckForProofs is
+ * never triggered: a payment received unmined stays `unproven` until the two-hour fallback.
+ *
+ * In spv mode the wallet's header chain is validated under the chain's rules (HeaderStore), so
+ * the monitor is given the same rules: the header must be well formed, its hash must be the
+ * hash of its fields, and it must satisfy `rules` for its declared bits.
+ */
+import { utils as chaintracksUtils } from '@bsv/wallet-toolbox-mobile'
+import type { HeaderRules } from '../headers/chainRules'
+
+const { validateHeaderFormat } = chaintracksUtils
+
+export interface MonitorBlockHeader {
+  version: number
+  previousHash: string
+  merkleRoot: string
+  time: number
+  bits: number
+  nonce: number
+  height: number
+  hash: string
+}
+
+/** A validated copy of `value` (only the eight header fields), or a throw naming `name`. */
+export function copyHeaderUnderRules(value: unknown, name: string, rules: HeaderRules): MonitorBlockHeader {
+  if (value === null || typeof value !== 'object') throw new Error(`The ${name} parameter must be a block header`)
+  const source = value as MonitorBlockHeader
+  const header: MonitorBlockHeader = {
+    version: source.version,
+    previousHash: source.previousHash,
+    merkleRoot: source.merkleRoot,
+    time: source.time,
+    bits: source.bits,
+    nonce: source.nonce,
+    height: source.height,
+    hash: source.hash
+  }
+  try {
+    validateHeaderFormat(header as never)
+    rules.validate({ height: header.height, hash: header.hash, bits: header.bits, time: header.time })
+  } catch (e) {
+    throw new Error(
+      `The ${name} parameter must be a canonical block header valid under ${rules.name} rules: ${(e as Error).message}`
+    )
+  }
+  return header
+}
+
+interface MonitorLike {
+  chaintracks: { findChainTipHeader: () => Promise<unknown> }
+  copyValidatedHeader?: (value: unknown, name: string) => MonitorBlockHeader
+  _tasks: { name: string }[]
+}
+
+/** Make `monitor` (and its NewHeader task) validate headers under `rules` instead of mainnet proof of work. */
+export function applyChainRulesToMonitorHeaders(monitor: MonitorLike, rules: HeaderRules): void {
+  monitor.copyValidatedHeader = (value, name) => copyHeaderUnderRules(value, name, rules)
+  const newHeader = monitor._tasks.find(t => t.name === 'NewHeader') as
+    | { getHeader?: () => Promise<MonitorBlockHeader> }
+    | undefined
+  if (newHeader) {
+    newHeader.getHeader = async () =>
+      copyHeaderUnderRules(await monitor.chaintracks.findChainTipHeader(), 'chain tip header', rules)
+  }
+}
diff --git a/node_modules/@bsv/expo-wallet-toolbox/core/spv/rawChaintracksClient.ts b/node_modules/@bsv/expo-wallet-toolbox/core/spv/rawChaintracksClient.ts
new file mode 100644
index 0000000..7e7c85c
--- /dev/null
+++ b/node_modules/@bsv/expo-wallet-toolbox/core/spv/rawChaintracksClient.ts
@@ -0,0 +1,89 @@
+/**
+ * A minimal chaintracks client for the header sync: present height and raw
+ * header bytes, nothing else, and no judgement of what it returns.
+ *
+ * Why not the toolbox's `ChaintracksServiceClient`: it validates every header it
+ * reads against the MAINNET proof-of-work limit, so it cannot read any chain
+ * with other rules (a local regtest, 0x207fffff). It would also be the wrong
+ * place to decide validity: in spv mode the wallet's own `HeaderStore` applies
+ * the chain's rules to every header, so this client only transports bytes.
+ *
+ * Speaks the Arcade chaintracks v1 envelope: `{ "status": "success", "value": … }`.
+ */
+import { arcadeAuthHeaders } from './arcadeAuth'
+
+const HEADER_BYTES = 80
+const MAX_BODY_CHARS = 8 * 1024 * 1024
+const TIMEOUT_MS = 30_000
+
+export class RawChaintracksClient {
+  /** `false` tells the Monitor not to subscribe: there is no event stream here. */
+  readonly supportsReorgEvents = false
+  private readonly base: string
+  private readonly authHeaders: Record<string, string>
+
+  constructor(
+    baseUrl: string,
+    private readonly fetcher: typeof fetch = (...a) => fetch(...a),
+    apiKey?: string | null
+  ) {
+    this.base = baseUrl.replace(/\/+$/, '')
+    this.authHeaders = arcadeAuthHeaders(apiKey)
+  }
+
+  private async get(path: string): Promise<unknown> {
+    const ctl = new AbortController()
+    const timer = setTimeout(() => ctl.abort(), TIMEOUT_MS)
+    try {
+      const res = await this.fetcher(`${this.base}${path}`, { signal: ctl.signal, headers: this.authHeaders })
+      if (!res.ok) throw new Error(`chaintracks ${path.split('?')[0]} answered HTTP ${res.status}`)
+      const text = await res.text()
+      if (text.length > MAX_BODY_CHARS) throw new Error('chaintracks response is too large')
+      let json: any
+      try {
+        json = JSON.parse(text)
+      } catch {
+        throw new Error(`chaintracks ${path.split('?')[0]} did not answer JSON`)
+      }
+      if (json?.status !== 'success' || !('value' in json)) {
+        throw new Error(`chaintracks ${path.split('?')[0]} did not report success`)
+      }
+      return json.value
+    } finally {
+      clearTimeout(timer)
+    }
+  }
+
+  async getPresentHeight(): Promise<number> {
+    const v = await this.get('/getPresentHeight')
+    if (typeof v !== 'number' || !Number.isSafeInteger(v) || v < 0) {
+      throw new Error('chaintracks present height is not a whole number')
+    }
+    return v
+  }
+
+  /** Hex of `count` headers from `height`; may be shorter at the tip, empty past it. Not validated here. */
+  async getHeaders(height: number, count: number): Promise<string> {
+    if (!Number.isSafeInteger(height) || height < 0) throw new Error('getHeaders: height must be a whole number')
+    if (!Number.isSafeInteger(count) || count < 1) throw new Error('getHeaders: count must be a positive whole number')
+    const v = await this.get(`/getHeaders?height=${height}&count=${count}`)
+    if (typeof v !== 'string') throw new Error('chaintracks headers are not a hex string')
+    if (v === '') return ''
+    if (!/^[0-9a-fA-F]+$/.test(v) || v.length % (HEADER_BYTES * 2) !== 0) {
+      throw new Error('chaintracks headers are not whole 80-byte headers in hex')
+    }
+    if (v.length / (HEADER_BYTES * 2) > count) throw new Error('chaintracks returned more headers than requested')
+    return v
+  }
+
+  // Event streams do not exist here; OfflineFirstChaintracks turns these into inert subscriptions.
+  async subscribeHeaders(_listener?: unknown): Promise<string> {
+    throw new Error('Method not implemented.')
+  }
+  async subscribeReorgs(_listener?: unknown): Promise<string> {
+    throw new Error('Method not implemented.')
+  }
+  async unsubscribe(_id?: string): Promise<boolean> {
+    throw new Error('Method not implemented.')
+  }
+}
diff --git a/node_modules/@bsv/expo-wallet-toolbox/core/spv/remoteChaintracks.ts b/node_modules/@bsv/expo-wallet-toolbox/core/spv/remoteChaintracks.ts
