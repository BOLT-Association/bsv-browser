+/**
+ * Per-chain header acceptance rules, kept apart from `HeaderStore` so the
+ * network-specific part lives in one place and can be tested on its own.
+ *
+ * `HeaderStore` validates linkage itself. What counts as an acceptable
+ * difficulty is the chain's business, and is decided here:
+ *
+ *  · `defaultRules` is the toolbox's own check (`validateHeaderProofOfWork`):
+ *    hash meets the header's declared target and that target is within the
+ *    mainnet proof-of-work limit. It does NOT enforce retargeting, median-time
+ *    or most-work, and says so by name. Used for main / test / ttn exactly as
+ *    before.
+ *  · `regtestRules` is a chain with no retargeting and a fixed limit
+ *    (0x207fffff): every header must declare exactly that, and meet it.
+ *    Without this a regtest chain cannot pass the mainnet limit at all.
+ *
+ * Mainnet and testnet retarget/DAA rules are NOT implemented yet. They need
+ * headers from before the checkpoint window, so they are a separate piece of
+ * work (see docs/bsv-browser-spv.md); this module is where they will go.
+ */
+import { utils as chaintracksUtils } from '@bsv/wallet-toolbox-mobile'
+
+const { validateHeaderProofOfWork } = chaintracksUtils
+
+export interface HeaderForRules {
+  height: number
+  /** Display-order hex block hash, recomputed by the caller (never taken from a source). */
+  hash: string
+  bits: number
+  time: number
+}
+
+export interface PreviousForRules {
+  bits: number
+  time: number
+}
+
+export interface HeaderRules {
+  readonly name: string
+  /** Throws when the header violates the chain's difficulty rules. `prev` is absent for the first header of a window. */
+  validate(header: HeaderForRules, prev?: PreviousForRules): void
+  /** Work represented by a header declaring `bits`. */
+  workForBits(bits: number): bigint
+}
+
+/** Expand compact `bits` to a target; throws on a malformed encoding. */
+export function targetFromBits(bits: number): bigint {
+  if (!Number.isSafeInteger(bits) || bits < 0 || bits > 0xffffffff) throw new Error('Block target encoding is invalid.')
+  const size = bits >>> 24
+  const word = bits & 0x7fffff
+  const negative = word !== 0 && (bits & 0x800000) !== 0
+  if (word === 0 || negative || size > 34 || (word > 0xff && size > 33) || (word > 0xffff && size > 32)) {
+    throw new Error('Block target encoding is invalid.')
+  }
+  return size <= 3 ? BigInt(word) >> BigInt(8 * (3 - size)) : BigInt(word) << BigInt(8 * (size - 3))
+}
+
+/** Expected hashes needed to find a header at `bits`: floor(2^256 / (target + 1)), as Bitcoin counts it. */
+export function workFromBits(bits: number): bigint {
+  const target = targetFromBits(bits)
+  return (BigInt(1) << BigInt(256)) / (target + BigInt(1))
+}
+
+const meetsTarget = (hash: string, bits: number): boolean => BigInt('0x' + hash) <= targetFromBits(bits)
+
+export const defaultRules: HeaderRules = {
+  name: 'default',
+  validate(h) {
+    validateHeaderProofOfWork({ bits: h.bits, hash: h.hash, height: h.height, time: h.time } as any)
+  },
+  workForBits: workFromBits
+}
+
+export const REGTEST_POW_LIMIT_BITS = 0x207fffff
+
+export const regtestRules: HeaderRules = {
+  name: 'regtest',
+  validate(h) {
+    if (h.bits !== REGTEST_POW_LIMIT_BITS) {
+      throw new Error(
+        `header at height ${h.height} declares bits 0x${h.bits.toString(16)}; regtest has no difficulty adjustment, ` +
+          `bits must be 0x${REGTEST_POW_LIMIT_BITS.toString(16)} (proof-of-work limit)`
+      )
+    }
+    if (!meetsTarget(h.hash, h.bits)) {
+      throw new Error(`header at height ${h.height} does not meet its declared target`)
+    }
+  },
+  workForBits: workFromBits
+}
+
+export function rulesForChain(chain: string): HeaderRules {
+  return chain === 'regtest' ? regtestRules : defaultRules
+}
